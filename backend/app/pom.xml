<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         Moduł: app – główna aplikacja Spring Boot
         Zawiera: api/, domain/, infrastructure/, security/
         =================================================================== -->

    <parent>
        <groupId>com.contactcenter</groupId>
        <artifactId>contact-center-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>contact-center-app</artifactId>
    <packaging>jar</packaging>

    <name>Contact Center App</name>
    <description>Główny moduł aplikacji Spring Boot – Contact Center SaaS</description>

    <dependencies>

        <!-- =================================================================
             Spring Boot Starters
             ================================================================= -->

        <!-- Web MVC – REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA – repozytoria, encje -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security – autoryzacja, filtr JWT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Actuator – /actuator/health, /actuator/metrics, /actuator/info -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data Redis – cache, JWT blacklist, agent presence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- RabbitMQ / AMQP – asynchroniczna komunikacja zdarzeń -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Spring WebSocket + STOMP – real-time events do Agent Desktop -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Spring AOP – @Audited aspect, TenantContext cross-cutting concerns -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- =================================================================
             Baza danych
             ================================================================= -->

        <!-- PostgreSQL JDBC Driver (runtime) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway – automatyczne migracje bazy danych przy starcie -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway PostgreSQL support (wymagane od Flyway 10.x) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- =================================================================
             Dokumentacja API
             ================================================================= -->

        <!-- SpringDoc OpenAPI 3 – generowanie Swagger UI i spec OpenAPI 3.0 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- =================================================================
             Narzędzia developerskie
             ================================================================= -->

        <!-- Lombok – redukcja boilerplate (gettery, settery, builder) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct – mapowanie encji ↔ DTO w czasie kompilacji -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Jackson – serializacja/deserializacja JSON (już w starter-web) -->
        <!-- Jackson Datatype JSR310 – obsługa Java 8 Date/Time API -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- =================================================================
             JWT – parsowanie i walidacja tokenów RS256 (BE-002)
             ================================================================= -->

        <!-- JJWT API – interfejs publiczny -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- JJWT implementacja (runtime) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JJWT Jackson serializer (runtime) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- =================================================================
             MFA / TOTP – RFC 6238 (BE-003)
             ================================================================= -->

        <!-- TOTP: generowanie/weryfikacja kodów Google Authenticator / RFC 6238 -->
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp-spring-boot-starter</artifactId>
            <version>1.7.1</version>
        </dependency>

        <!-- =================================================================
             Apache POI – eksport XLSX (BE-028)
             ================================================================= -->

        <!-- Apache POI OOXML – generowanie plików Excel .xlsx -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- =================================================================
             AWS SDK v2 – S3 client dla nagrań (BE-010)
             ================================================================= -->

        <!-- S3 client – upload nagrań, presigned URLs -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <!-- Wyklucz commons-logging – Spring Boot używa spring-jcl -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- =================================================================
             OpenCSV – parsowanie plików CSV (BE-023)
             ================================================================= -->

        <!-- OpenCSV – parser CSV z obsługą nagłówków, cudzysłowów, kodowania -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.9</version>
        </dependency>

        <!-- =================================================================
             Twilio SDK – adapter telefonii (BE-029)
             ================================================================= -->

        <!-- Twilio Programmable Voice REST API client -->
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.9.1</version>
            <exclusions>
                <!-- Wyklucz commons-logging – Spring Boot używa spring-jcl -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- =================================================================
             Jakarta Mail (IMAP polling + SMTP) – BE-015
             Spring Boot 3.x zarządza wersją przez BOM
             ================================================================= -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <!-- =================================================================
             Mustache – silnik renderowania szablonów email (BE-016)
             ================================================================= -->
        <dependency>
            <groupId>com.github.spullara.mustache.java</groupId>
            <artifactId>compiler</artifactId>
            <version>0.9.14</version>
        </dependency>

        <!-- =================================================================
             ClickHouse JDBC – Data Warehouse writer (BE-030b)
             Używamy clickhouse-jdbc BEZ klasyfikatora "all" – Spring Boot Maven
             Plugin nie rozpakowuje shaded jarów z klasyfikatorem do fat JAR
             (BOOT-INF/lib), co powoduje NoClassDefFoundError na ClickHouseClient.
             Zamiast tego deklarujemy jawnie trzy artefakty z tej samej wersji:
               - clickhouse-jdbc        – sterownik JDBC
               - clickhouse-client      – core client API (ClickHouseClient, etc.)
               - clickhouse-http-client – transport HTTP (port 8123)
             ClickHouse nie wspiera transakcji – nie opakowuj INSERT w @Transactional.
             ================================================================= -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>0.6.5</version>
        </dependency>
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-client</artifactId>
            <version>0.6.5</version>
        </dependency>
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-http-client</artifactId>
            <version>0.6.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.8.0</version>
        </dependency>

        <!-- =================================================================
             Hot reload w trybie dev
             ================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- =================================================================
             Testy
             ================================================================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test – mockowanie autoryzacji w testach -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring AMQP Test – TestRabbitTemplate -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers – integracyjne testy z prawdziwą bazą PostgreSQL -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Spring Boot Maven Plugin – budowanie wykonywalnego fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.contactcenter.app.ContactCenterApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Compiler – Java 21 + procesory adnotacji -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- JaCoCo – pokrycie kodu testami -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

        <!-- Kopiowanie migracji Flyway z backend/src/main/resources do modułu app -->
        <!-- Flyway czyta domyślnie z classpath:db/migration -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Migracje Flyway ze wspólnego katalogu backend/src/main/resources -->
            <resource>
                <directory>../src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

    </build>

</project>
