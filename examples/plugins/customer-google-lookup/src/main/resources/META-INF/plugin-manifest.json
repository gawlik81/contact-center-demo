      "sandbox": "allow-scripts"
    }
  ],
  "manualActions": [
    {
      "actionId": "refresh-google-search",
      "label": "Szukaj ponownie w Google",
      "mountPoint": "AGENT_DESKTOP_TOOLBAR"
    }
  ],
