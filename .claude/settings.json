{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(cd backend*)",
      "Bash(cd frontend*)",
      "Bash(npx ng*)",
      "Bash(npx ng build*)",
      "Bash(npx ng serve*)",
      "Write"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const f=(j.tool_input||{}).file_path||'';if(f&&/\\\\.(ts|html|scss)$/.test(f)){const {execSync}=require('child_process');try{execSync('npx prettier --write '+JSON.stringify(f),{cwd:'E:/ClaudAI/contact-center-demo/frontend',stdio:'inherit'});}catch(e){}}});\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "iac-terraform@devops-skills": true,
    "k8s-troubleshooter@devops-skills": true,
    "aws-cost-optimization@devops-skills": true,
    "ci-cd@devops-skills": true,
    "gitops-workflows@devops-skills": true,
    "monitoring-observability@devops-skills": true
  }
}
