# ── Baza danych ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/contact_center
DB_USERNAME=ccapp
DB_PASSWORD=****************************
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=****************************
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ccapp
RABBITMQ_PASSWORD=****************************
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false

# ── JWT (wygeneruj: openssl rand -base64 64) ─────────────────
JWT_SECRET=****************************************************************************************
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── MinIO / S3 ───────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contact-center-recordings
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
# Publiczny endpoint dla presigned URL — ustaw na ten sam URL co APP_BASE_URL
S3_PUBLIC_ENDPOINT=https://rafaela-uncalumnious-refreshedly.ngrok-free.dev

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/contact_center_dw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Twilio (opcjonalne — zostaw puste jeśli nie używasz VoIP) ─
# Adapter telefonii: mock (symulator in-memory) | twilio (prawdziwe Twilio API)
# Ustaw TELEPHONY_PROVIDER=twilio + TWILIO_ENABLED=true gdy chcesz prawdziwego Twilio.
# W lokalnym demo Twilio jest skonfigurowane przez ENV vars poniżej.
TWILIO_ACCOUNT_SID=**********************************
TWILIO_AUTH_TOKEN=********************************
#TWILIO_PHONE_NUMBER=************
#TWILIO_API_KEY_SID=**********************************
#TWILIO_API_KEY_SECRET=********************************
#TWILIO_TWIML_APP_SID=**********************************
TWILIO_RECORDING_ENABLED=true
TWILIO_SIGNATURE_VALIDATION_ENABLED=false
TWILIO_PER_TENANT_CALLBACK_URL_ENABLED=false
TWILIO_STATUS_CALLBACK_URL=https://rafaela-uncalumnious-refreshedly.ngrok-free.dev/api/telephony/webhook/twilio

# ── Aplikacja ────────────────────────────────────────────────
# WAŻNE: uzupełnij APP_BASE_URL po uruchomieniu ngrok (Krok 7)
APP_BASE_URL=https://rafaela-uncalumnious-refreshedly.ngrok-free.dev
CORS_ALLOWED_ORIGINS=https://rafaela-uncalumnious-refreshedly.ngrok-free.dev,http://localhost:4200,http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=https://rafaela-uncalumnious-refreshedly.ngrok-free.dev,http://localhost:4200,http://localhost:3000
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_PATH=/var/log/contact-center
LOG_FILE=/var/log/contact-center/app.log
PROMETHEUS_ENABLED=false
APP_ENCRYPTION_SECRET=********************************************
EMAIL_ENCRYPTION_KEY=****************************************************************
SOCIAL_TOKEN_ENCRYPTION_KEY=****************************************************************
DIALER_AGENT_POLL_INTERVAL_MS=15000
ETL_DW_TYPE=clickhouse

# ── AI Voicebot (endpoint generowania podsumowań EPIC-26) ─────
VOICEBOT_URL=http://voicebot:8001
VOICEBOT_ENABLED=true