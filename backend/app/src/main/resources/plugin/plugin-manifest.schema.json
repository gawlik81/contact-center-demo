{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contactcenter.example/schemas/plugin-manifest.schema.json",
  "title": "Contact Center Plugin Manifest",
  "description": "Schema for META-INF/plugin-manifest.json (ARCHITECTURE.md sec. 11.2, EPIC-28). Enum membership for extensionPoints/permissions against the platform's live enum is enforced separately in PluginValidationServiceImpl, not here, since JSON Schema enums would have to be duplicated and kept in sync by hand.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "pluginKey",
    "displayName",
    "version",
    "vendor",
    "sdkVersion",
    "entryPointClass",
    "extensionPoints",
    "permissions",
    "checksumSha256"
  ],
  "properties": {
    "pluginKey": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 100
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "vendorContact": {
      "type": "string",
      "maxLength": 200
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "entryPointClass": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "extensionPoints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "uiPanels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["panelId", "mountPoint", "url"],
        "properties": {
          "panelId": { "type": "string", "minLength": 1 },
          "mountPoint": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "sandbox": { "type": "string" }
        }
      }
    },
    "manualActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["actionId", "label", "mountPoint"],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "mountPoint": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checksumSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
